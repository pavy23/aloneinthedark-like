{
  "name": "beneath-the-keel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 1990s-style third-person 3D exploration & puzzle horror game for the web (three.js), with a follow camera or the original fixed cameras",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vite build && node scripts/playthrough.mjs",
    "shots": "vite build && node scripts/shots.mjs",
    "build:artifact": "vite build --config vite.artifact.config.ts && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
